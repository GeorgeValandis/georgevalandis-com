<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header always set Cache-Control "public, max-age=300, must-revalidate"
    Header always unset Pragma
    Header always unset Expires
  </FilesMatch>

  <FilesMatch "\.(css|js|mjs|woff|woff2)$">
    Header always set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(png|jpe?g|webp|avif|ico|svg)$">
    Header always set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "^(?!robots\.txt$).+\.txt$">
    Header always set X-Robots-Tag "noindex, nofollow, noarchive"
  </FilesMatch>

  <FilesMatch "^(robots\.txt|sitemap\.xml)$">
    Header always set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>
